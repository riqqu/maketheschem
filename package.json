{
  "name": "maketheschem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn images into one-layer Minecraft pixel art and export Sponge v3 .schem files.",
  "scripts": {
    "extract": "node scripts/extract-blocks.mjs",
    "predev": "node scripts/ensure-blocks.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-blocks.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "yauzl": "^3.4.0"
  }
}
