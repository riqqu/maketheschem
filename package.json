{
  "name": "maketheschem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn images into one-layer Minecraft pixel art, and 3D models into 3D builds, and export Sponge v3 .schem or .litematic files.",
  "scripts": {
    "extract": "node scripts/extract-blocks.mjs",
    "predev": "node scripts/ensure-blocks.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-blocks.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "yauzl": "^3.4.0"
  }
}
